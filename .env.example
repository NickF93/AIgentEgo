# Runtime API
AGENT_HOST=0.0.0.0
AGENT_PORT=8080
REQUEST_TIMEOUT_SECONDS=120
LOG_LEVEL=INFO

# LLM provider
LLM_BACKEND=ollama
LLM_BASE_URL=http://ollama:11434
CHAT_MODEL=llama3.2:3b
EMBEDDING_MODEL=nomic-embed-text

# Optional llama.cpp backend. Keep the Ollama defaults above for the default
# Docker Compose stack. Uncomment these only when a separately managed
# llama-server is reachable from the API process.
# LLM_BACKEND=llamacpp
# LLM_BASE_URL=http://localhost:8081
# CHAT_MODEL=<model exposed by llama-server>
# EMBEDDING_MODEL=<embedding model exposed by llama-server>
# If the API runs inside Docker, replace localhost with an address reachable
# from the agent-api container.

# Legacy Ollama compatibility aliases. Prefer the provider-neutral LLM_*/model
# variables above for new configuration.
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_CHAT_MODEL=llama3.2:3b
# OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional host port overrides for Docker Compose
AGENT_HOST_PORT=8080
OLLAMA_HOST_PORT=11434
